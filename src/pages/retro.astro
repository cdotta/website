---
// Hidden experiment: the CV as an old-school game menu. Reachable only at /retro.
import '@fontsource/press-start-2p';
import '@fontsource/vt323';
import Layout from '../layouts/Layout.astro';
import { site, skills, experience, projects, earlier, education } from '../config';

const level = new Date().getFullYear() - 2013;
---

<Layout title={`${site.name} · retro`} noindex>
  <main class="retro">
    <div class="crt" aria-hidden="true"></div>

    <!-- TITLE -->
    <section class="screen title active" id="title">
      <div class="logo">CRISTIAN<br />DOTTA</div>
      <div class="tagline">SENIOR BACKEND ENGINEER</div>
      <ul class="menu start">
        <li data-go="main">PRESS START</li>
      </ul>
      <div class="copyright">© 2013 – {new Date().getFullYear()} CRISISLABS</div>
    </section>

    <!-- MAIN MENU -->
    <section class="screen" id="main">
      <div class="box">
        <div class="box-title">MAIN MENU</div>
        <ul class="menu">
          <li data-go="about">ABOUT</li>
          <li data-go="work">WORK</li>
          <li data-go="toolkit">TOOLKIT</li>
          <li data-go="projects">PROJECTS</li>
          <li data-go="contact">CONTACT</li>
          <li><a href={site.resumePdf} download>RESUME (PDF)</a></li>
          <li><a href="/">EXIT TO NORMAL SITE</a></li>
        </ul>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="screen" id="about">
      <div class="box">
        <div class="box-title">ABOUT</div>
        <div class="char">
          <canvas class="sprite" width="48" height="48" aria-hidden="true"></canvas>
          <dl class="stats">
            <dt>NAME</dt><dd>{site.name}</dd>
            <dt>LV</dt><dd>{level}</dd>
            <dt>CLASS</dt><dd>Backend engineer</dd>
            <dt>BASE</dt><dd>{site.location}</dd>
          </dl>
        </div>
        <p class="body">{site.description}</p>
        <div class="sub-title">EDUCATION</div>
        <ul class="plain">
          {education.map((ed) => (<li>{ed.title} <span class="dim">— {ed.meta}</span></li>))}
        </ul>
        <ul class="menu">
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    <!-- WORK (submenu) -->
    <section class="screen" id="work">
      <div class="box">
        <div class="box-title">WORK</div>
        <ul class="menu cards">
          {
            experience.map((job, i) => (
              <li data-go={`work-${i}`}>
                <span class="card-title">{job.org}</span>
                <span class="dim">{job.period}{job.role && ` · ${job.role}`}</span>
              </li>
            ))
          }
          <li data-go="earlier">
            <span class="card-title">Earlier</span>
            <span class="dim">2012 — 2021 · four more stops</span>
          </li>
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    {
      experience.map((job, i) => (
        <section class="screen" id={`work-${i}`}>
          <div class="box">
            <div class="box-title">{job.org}</div>
            <div class="dim meta">
              {job.period}
              {job.meta && ` · ${job.meta}`}
              {job.role && <br />}
              {job.role}
            </div>
            <ul class="plain bullets">
              {job.bullets.map((b) => (<li set:html={b} />))}
            </ul>
            <ul class="menu">
              <li data-back>BACK</li>
            </ul>
          </div>
        </section>
      ))
    }

    <section class="screen" id="earlier">
      <div class="box">
        <div class="box-title">EARLIER</div>
        <ul class="plain bullets">
          {
            earlier.map((e) => (
              <li>
                <strong>{e.name}</strong> <span class="dim">— {e.meta}</span>
                <br />{e.body}
              </li>
            ))
          }
        </ul>
        <ul class="menu">
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    <!-- TOOLKIT -->
    <section class="screen" id="toolkit">
      <div class="box">
        <div class="box-title">TOOLKIT</div>
        <dl class="stats wide">
          {skills.map((s) => (<><dt>{s.label}</dt><dd>{s.body}</dd></>))}
        </dl>
        <ul class="menu">
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="screen" id="projects">
      <div class="box">
        <div class="box-title">PROJECTS</div>
        <ul class="menu cards">
          {
            projects.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener">
                  <span class="card-title">{p.name} <span class="tag">{p.tag}</span></span>
                  <span class="body">{p.description}</span>
                  <span class="dim">{p.stack} · {p.linkLabel} ↗</span>
                </a>
              </li>
            ))
          }
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="screen" id="contact">
      <div class="box">
        <div class="box-title">CONTACT</div>
        <p class="body dim">{site.location}</p>
        <ul class="menu cards">
          <li><a href={`mailto:${site.email}`}><span class="card-title">EMAIL</span><span class="dim">{site.email}</span></a></li>
          <li><a href={site.github} target="_blank" rel="noopener"><span class="card-title">GITHUB</span><span class="dim">{site.githubLabel}</span></a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener"><span class="card-title">LINKEDIN</span><span class="dim">{site.linkedinLabel}</span></a></li>
          <li data-back>BACK</li>
        </ul>
      </div>
    </section>

    <footer class="hud" aria-hidden="true">
      <span><b>↑↓</b> MOVE</span>
      <span><b>ENTER</b> SELECT</span>
      <span><b>ESC</b> BACK</span>
      <span><b>M</b> SOUND: <span id="sound-state">ON</span></span>
    </footer>
  </main>

  <script>
    let audio: AudioContext | undefined;
    let sound = true;
    const beep = (freq: number, secs: number) => {
      if (!sound) return;
      try {
        audio ??= new AudioContext();
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = 'square';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.04, audio.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + secs);
        osc.connect(gain).connect(audio.destination);
        osc.start();
        osc.stop(audio.currentTime + secs);
      } catch {
        /* no audio — fine */
      }
    };

    const screens = document.querySelectorAll<HTMLElement>('.retro .screen');
    const stack = ['title'];
    const cursor = new Map<string, number>();
    const top = () => stack[stack.length - 1];
    const items = () => [...document.querySelectorAll<HTMLElement>(`#${top()} .menu > li`)];

    function render() {
      screens.forEach((s) => s.classList.toggle('active', s.id === top()));
      const i = cursor.get(top()) ?? 0;
      items().forEach((li, n) => li.classList.toggle('is-selected', n === i));
    }

    function move(delta: number) {
      const list = items();
      if (list.length < 2) return false; // single BACK item: let the browser scroll instead
      const i = ((cursor.get(top()) ?? 0) + delta + list.length) % list.length;
      cursor.set(top(), i);
      render();
      list[i].scrollIntoView({ block: 'nearest' });
      beep(520, 0.04);
      return true;
    }

    function back() {
      if (stack.length < 2) return;
      stack.pop();
      beep(260, 0.07);
      render();
      window.scrollTo(0, 0);
    }

    function select() {
      const li = items()[cursor.get(top()) ?? 0];
      if (!li) return;
      if ('back' in li.dataset) return back();
      beep(880, 0.09);
      if (li.dataset.go) {
        stack.push(li.dataset.go);
        render();
        window.scrollTo(0, 0);
      } else {
        li.querySelector('a')?.click();
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k === 'm') {
        sound = !sound;
        document.getElementById('sound-state')!.textContent = sound ? 'ON' : 'OFF';
        beep(660, 0.05);
        return;
      }
      if (top() === 'title') {
        if (k === 'enter' || k === ' ' || k.length === 1) {
          e.preventDefault();
          select();
        }
        return;
      }
      if (['arrowup', 'w', 'k'].includes(k)) {
        if (move(-1)) e.preventDefault();
      } else if (['arrowdown', 's', 'j'].includes(k)) {
        if (move(1)) e.preventDefault();
      } else if (['enter', ' ', 'z'].includes(k)) {
        e.preventDefault();
        select();
      } else if (['escape', 'x', 'backspace'].includes(k)) {
        e.preventDefault();
        back();
      }
    });

    // Mouse / touch: hover moves the cursor, click selects. Synthetic clicks from
    // select() → a.click() are !isTrusted and must fall through to the browser.
    document.querySelectorAll<HTMLElement>('.retro .menu > li').forEach((li) => {
      li.addEventListener('mouseenter', () => {
        cursor.set(top(), items().indexOf(li));
        render();
      });
      li.addEventListener('click', (e) => {
        if (!e.isTrusted) return;
        e.preventDefault();
        cursor.set(top(), items().indexOf(li));
        select();
      });
    });

    // Portrait → 48px sprite with a crushed palette, upscaled with pixelated rendering.
    const canvas = document.querySelector<HTMLCanvasElement>('.sprite');
    const img = new Image();
    img.onload = () => {
      const ctx = canvas?.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(img, 0, 0, 48, 48);
      const data = ctx.getImageData(0, 0, 48, 48);
      for (let i = 0; i < data.data.length; i++) data.data[i] = Math.round(data.data[i] / 51) * 51;
      ctx.putImageData(data, 0, 0);
    };
    img.src = '/portrait.jpg';

    render();
  </script>
</Layout>

<style is:global>
  .retro {
    --bg: #120c1f;
    --box-top: #2a1c5e;
    --box-bottom: #150e33;
    --fg: #f4f0ff;
    --dim: #a89bd1;
    --accent: #ffd23f;
    --pixel: 'Press Start 2P', monospace;
    --term: 'VT323', monospace;

    min-height: 100dvh;
    padding: 24px 16px 72px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--term);
    font-size: 22px;
    line-height: 1.3;
    text-rendering: optimizeSpeed;
    -webkit-font-smoothing: none;
  }
  html:has(.retro) {
    background: #120c1f;
    scroll-behavior: auto;
  }
  .retro a {
    color: inherit;
  }

  /* CRT: scanlines + vignette. */
  .retro .crt {
    position: fixed;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.28) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.55));
  }

  .retro .screen {
    display: none;
    max-width: 760px;
    margin: 0 auto;
  }
  .retro .screen.active {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100dvh - 96px);
  }

  /* Title screen. */
  .retro .title.active {
    align-items: center;
    text-align: center;
    gap: 28px;
  }
  .retro .logo {
    font-family: var(--pixel);
    font-size: clamp(26px, 7vw, 56px);
    line-height: 1.25;
    color: var(--accent);
    text-shadow: 4px 4px 0 #6d4d97, 8px 8px 0 #000;
  }
  .retro .tagline {
    font-family: var(--pixel);
    font-size: clamp(9px, 2vw, 13px);
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .retro .start {
    margin-top: 32px;
  }
  .retro .start li.is-selected::before {
    display: none; /* the whole label blinks instead of a cursor */
  }
  .retro .start li {
    animation: blink 1.1s steps(1) infinite;
    padding-left: 0;
  }
  .retro .copyright {
    font-family: var(--pixel);
    font-size: 9px;
    color: var(--dim);
    margin-top: 40px;
  }

  /* Dialog box. */
  .retro .box {
    background: linear-gradient(180deg, var(--box-top), var(--box-bottom));
    border: 4px solid var(--fg);
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    padding: 20px 22px 16px;
    margin: 8px;
  }
  .retro .box-title,
  .retro .sub-title {
    font-family: var(--pixel);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .retro .sub-title {
    font-size: 10px;
    margin: 22px 0 10px;
  }
  .retro .body {
    margin: 0 0 6px;
  }
  .retro .dim {
    color: var(--dim);
  }
  .retro .meta {
    margin: -8px 0 16px;
  }
  .retro .tag {
    font-family: var(--pixel);
    font-size: 8px;
    color: var(--accent);
    margin-left: 8px;
    vertical-align: middle;
  }

  /* Menu with cursor. */
  .retro .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--pixel);
    font-size: 13px;
    line-height: 1;
  }
  .retro .menu > li {
    position: relative;
    padding: 12px 8px 12px 30px;
    cursor: pointer;
  }
  .retro .menu > li::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 50%;
    transform: translateY(-50%);
    border-left: 12px solid var(--accent);
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    visibility: hidden;
  }
  .retro .menu > li.is-selected {
    color: var(--accent);
  }
  .retro .menu > li.is-selected::before {
    visibility: visible;
    animation: blink 0.8s steps(1) infinite;
  }
  .retro .menu a {
    display: block;
    text-decoration: none;
  }
  .retro .menu > li[data-back] {
    margin-top: 16px;
  }

  /* Cards: menu items with a body. */
  .retro .cards > li {
    font-family: var(--term);
    font-size: 22px;
    line-height: 1.25;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .retro .cards > li::before {
    top: 22px;
    transform: none;
  }
  .retro .cards > li[data-back] {
    font-family: var(--pixel);
    font-size: 13px;
    line-height: 1;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .retro .cards > li[data-back]::before {
    top: 50%;
    transform: translateY(-50%);
  }
  .retro .card-title {
    display: block;
    font-family: var(--pixel);
    font-size: 12px;
    line-height: 1.4;
    margin-bottom: 6px;
  }
  .retro .cards .body,
  .retro .cards .dim {
    display: block;
  }
  .retro .cards .body {
    margin: 0 0 4px;
  }

  /* Plain lists and stats. */
  .retro .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .retro .bullets > li {
    padding-left: 22px;
    position: relative;
    margin-bottom: 12px;
  }
  .retro .bullets > li::before {
    content: '»';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .retro .bullets em {
    font-style: normal;
    color: var(--accent);
  }
  .retro .stats {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 18px;
    margin: 0;
  }
  .retro .stats dt {
    font-family: var(--pixel);
    font-size: 10px;
    line-height: 1.6;
    color: var(--accent);
    text-transform: uppercase;
  }
  .retro .stats dd {
    margin: 0;
  }
  .retro .stats.wide {
    gap: 14px 18px;
    margin-bottom: 8px;
  }
  .retro .char {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    margin-bottom: 18px;
  }
  .retro .sprite {
    width: 144px;
    height: 144px;
    flex-shrink: 0;
    image-rendering: pixelated;
    border: 3px solid var(--fg);
    background: #000;
  }

  /* HUD. */
  .retro .hud {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 26px;
    padding: 12px 16px;
    background: #000;
    border-top: 3px solid var(--fg);
    font-family: var(--pixel);
    font-size: 9px;
    color: var(--dim);
  }
  .retro .hud b {
    color: var(--accent);
    font-weight: normal;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .retro {
      font-size: 20px;
      padding-top: 12px;
    }
    .retro .box {
      padding: 16px 14px 12px;
    }
    .retro .stats {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .retro .stats.wide dd {
      margin-bottom: 8px;
    }
    .retro .char {
      flex-direction: column;
    }
    .retro .hud {
      display: none; /* keyboard hints are noise on touch */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .retro .menu > li.is-selected::before,
    .retro .start li {
      animation: none;
    }
  }
</style>
